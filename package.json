{
  "name": "capability-runner",
  "version": "1.0.0",
  "description": "Computer-use automation system: LLM discovery -> typed capability artifact -> deterministic replay, with guardrails and human-in-the-loop handoff.",
  "type": "module",
  "scripts": {
    "target-app": "node target-app/server.js",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "operator": "tsx src/cli.ts operator",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
