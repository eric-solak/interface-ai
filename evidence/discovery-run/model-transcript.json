    "finalize": {
      "capabilityId": "member-savings-lookup",
      "title": "Lookup Member Savings Balance",
      "description": "Authenticates as an operator and retrieves the current savings balance for a specific member ID.",
      "inputs": [
        {
          "name": "member_id",
          "type": "string",
          "description": "The unique identifier for the member",
          "pattern": "^[0-9]{1,10}$"
        },
        {
          "name": "operator_id",
          "type": "string",
          "description": "The operator login ID",
          "pattern": "^[a-zA-Z0-9]{3,20}$"
        },
        {
          "name": "passcode",
          "type": "string",
          "description": "The operator authentication passcode",
          "pattern": "^.{4,16}$"
        }
      ],
      "detectors": [
        {
          "id": "invalid-credentials",
          "textMatches": "(invalid|incorrect|failed|denied|unauthorized)",
          "classify": "hard_failure",
          "outcomeCode": "AUTH_FAILURE",
          "message": "Authentication failed. Please check operator ID and passcode."
        },
        {
          "id": "member-not-found",
          "textMatches": "(no member found|member not found|no results)",
          "classify": "business_outcome",
          "outcomeCode": "MEMBER_NOT_FOUND",
          "message": "The requested member ID does not exist in the system."
        },
        {
          "id": "session-timeout",
          "textMatches": "(session expired|timed out|please log in)",
          "classify": "recoverable",
          "outcomeCode": "SESSION_EXPIRED",
          "message": "Session expired during lookup.",
          "recovery": {
            "kind": "rerun-steps",
            "fromStep": "s1"
          }
        },
        {
          "id": "server-error",
          "textMatches": "(internal server error|service unavailable|500|503)",
          "classify": "hard_failure",
          "outcomeCode": "SERVER_ERROR",
          "message": "The server encountered an error while processing the request."
        }
      ]
    }
  }
